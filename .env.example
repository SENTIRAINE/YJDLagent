RAG_DATABASE_PATH=data/index/rag.sqlite3
RAG_PROCESSED_PATH=data/processed/chunks.jsonl
RAG_SOURCE_GLOB=*.pdf
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_DIMENSION=768
RAG_EMBEDDING_BASE_URL=http://localhost:7997/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_API_KEY=
RAG_DENSE_WEIGHT=0.55
RAG_LEXICAL_WEIGHT=0.35
RAG_NUMBER_WEIGHT=0.10
RAG_DEFAULT_TOP_K=5
AGENT_DATABASE_PATH=data/index/agent.sqlite3
AGENT_STORAGE_BACKEND=mongodb
AGENT_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
AGENT_MONGODB_DATABASE=yjdl_agent
AGENT_MONGODB_REQUIRE_TRANSACTIONS=true
AGENT_CHECKPOINT_BACKEND=mongodb
AGENT_CHECKPOINT_MONGODB_DATABASE=yjdl_agent
AGENT_CHECKPOINT_DATABASE_PATH=data/index/agent-checkpoints.sqlite3
AGENT_SQLITE_BUSY_TIMEOUT_MS=5000
AGENT_SQLITE_WRITE_RETRY_ATTEMPTS=4
AGENT_SQLITE_WRITE_RETRY_BASE_DELAY_MS=50
AGENT_EVENT_RETENTION_SECONDS=86400
AGENT_MAX_RUN_SECONDS=180
AGENT_TOOL_TIMEOUT_SECONDS=125
AGENT_SSE_HEARTBEAT_SECONDS=15
AGENT_MAP_RESULT_LIMIT=50
AGENT_WORKER_CONCURRENCY=4
# API 进程建议设为 false；独立 agent-worker 进程会强制开启 Worker。
AGENT_WORKER_ENABLED=false
AGENT_WORKER_LEASE_SECONDS=60
AGENT_WORKER_POLL_SECONDS=0.2
AGENT_MAX_QUEUED_RUNS=100
AGENT_SHUTDOWN_GRACE_SECONDS=10
AGENT_USER_RATE_PER_MINUTE=10
AGENT_TENANT_RATE_PER_MINUTE=120
AGENT_TENANT_ACTIVE_RUNS=20
AGENT_TENANT_QUEUE_RUNS=100
AGENT_RUN_MAX_TOKENS=12000
AGENT_TENANT_DAILY_TOKENS=2000000
# 0 表示不启用本地费用阈值；生产应按租户合同配置。
AGENT_TENANT_DAILY_BUDGET=0
# 多实例生产环境必须配置；留空仅使用进程内开发实现。
AGENT_REDIS_URL=
# 可选：为固定部署单元设置稳定 ID；留空则自动使用 hostname/pid/随机后缀。
AGENT_WORKER_ID=
# Spring Boot caller setting: spring.mvc.async.request-timeout=210000
LANGGRAPH_SERVICE_TOKEN=
SPRING_BOOT_BASE_URL=http://localhost:8080
AGENT_TOOL_SERVICE_TOKEN=
OPENAI_CHAT_COMPLETIONS_URL=https://kuaipao.pro/v1/chat/completions
OPENAI_MODEL=gpt-5.4
OPENAI_API_KEY=
